# Root-level .env for Docker Compose variable substitution
# Copy this file to .env and fill in the values on your server:
#   cp .env.example .env && nano .env
# This file is gitignored — never commit .env with real secrets.

# Gemini OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Auth
JWT_SECRET=

# Google Cloud Storage
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_PREFIX=checkins
