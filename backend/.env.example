# Backend runtime settings
PORT=3001
STORE_MODE=postgres
DATABASE_URL=postgresql://username:password@localhost:5432/sachihouse
JWT_SECRET=change-this-to-a-long-random-secret

# Optional iCal sync tuning
ICAL_SYNC_ENABLED=true
ICAL_SYNC_TTL_MS=60000
ICAL_SYNC_TIMEOUT_MS=5000

# Gemini OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_GEMINI=false

# Google Cloud Storage for evidence uploads
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_PREFIX=checkins
GCP_SERVICE_ACCOUNT_FILE=gcp-service-account.json
# Local dev path when running the backend directly from /backend
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# Check-in retention policy and cleanup schedule
CHECKIN_RETENTION_DAYS=7
CHECKIN_RETENTION_NOTICE_VERSION=v1
CHECKIN_RETENTION_CLEANUP_INTERVAL_MS=3600000

# Public check-in token TTL (seconds)
CHECKIN_TOKEN_TTL_SECONDS=1800
